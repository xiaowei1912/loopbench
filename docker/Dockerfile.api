FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libosmesa6 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY packages packages
RUN pip install --no-cache-dir -e packages/spec \
 && pip install --no-cache-dir -e packages/sim-reference \
 && pip install --no-cache-dir -e packages/sim-mujoco \
 && pip install --no-cache-dir -e packages/policies \
 && pip install --no-cache-dir -e packages/evalkit \
 && pip install --no-cache-dir -e packages/adapters \
 && pip install --no-cache-dir -e packages/bridges \
 && pip install --no-cache-dir -e packages/example-suite \
 && pip install --no-cache-dir -e packages/api \
 && pip install --no-cache-dir -e packages/cli

ENV MUJOCO_GL=osmesa

ENV LOOPBENCH_DATA=/data
EXPOSE 43124
CMD ["loopbench", "serve", "--host", "0.0.0.0", "--port", "43124"]
